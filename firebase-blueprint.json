{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "User profile with syllabus preferences and student info",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "targetExam": { "type": "string" },
        "theme": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "EvaluationResult": {
      "title": "Evaluation Result",
      "description": "Evaluated answer sheets and marks breakdown",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "student_name": { "type": "string" },
        "roll_number": { "type": "string" },
        "total_score": { "type": "number" },
        "max_score": { "type": "number" },
        "evaluated_at": { "type": "string" },
        "savedAt": { "type": "string" }
      },
      "required": ["id", "userId"]
    },
    "MistakeRecord": {
      "title": "Mistake Record",
      "description": "Mistake diary record categorized by topic",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "topic": { "type": "string" },
        "mistake_type": { "type": "string" },
        "description": { "type": "string" },
        "occurrences": { "type": "number" }
      },
      "required": ["id", "userId"]
    },
    "GeneratedTest": {
      "title": "Generated Test",
      "description": "Adaptive generated test based on student weak areas",
      "type": "object",
      "properties": {
        "test_id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "total_marks": { "type": "number" },
        "created_at": { "type": "string" }
      },
      "required": ["test_id", "userId"]
    },
    "SupportTicket": {
      "title": "Support Ticket",
      "description": "Private student support ticket and communication with admin Himanshu Chawla",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "studentEmail": { "type": "string" },
        "category": { "type": "string" },
        "subjectTitle": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "studentId", "studentName"]
    }
  },
  "firestoreRules": "rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    match /{document=**} {\n      allow read, write: if true;\n    }\n  }\n}"
}
